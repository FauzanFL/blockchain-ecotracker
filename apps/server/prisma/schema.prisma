generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmissionLog {
  id String @id @default(uuid())
  factoryAddress String
  amount Float
  isSettled Boolean @default(false)
  txHash String?
  createdAt DateTime @default(now())

  @@map("emissions_log")
}
